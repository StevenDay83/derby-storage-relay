{
   "server":{
        "host":"0.0.0.0",
        "port":8080,
        "sessionTimeout":30000,
        "filteripfile":"./ipfilter.json"
   },
   "storage":{
        "directory":"./BlobData",
        "fileSuffix": "blob",
        "dataBlockLimit": 512000
   },
   "pointer":{
        "timestampDelta":300
   },
   "database":{
        "type":"sqlite",
        "file":"./pointers.db"
   },
   "database_mariadb_example":{
        "type":"mariadb",
        "host":"localhost",
        "port":3306,
        "username":"username",
        "password":"password",
        "pointerDatabase":"pointer_db"
   },
   "filter":{
     "filtergroupfile":"./filter.json",
     "filterkeysfile":"./filter_keys.json"
   },
   "cache":{
     "pointerCache":{
          "pointerCacheTTL":300,
          "maxPointers":10000
     },
     "blobCache":{
          "blobCacheTTL":300,
          "blobCacheSizeLimit":100000000
     }
   }
}
